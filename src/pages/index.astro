---
import Shell from '../layouts/Shell.astro';
import Hero from '../components/hero/Hero.astro';
import ProjectFeature from '../components/projects/ProjectFeature.astro';
import Profile from '../components/profile/Profile.astro';
import OtherProjects from '../components/projects/OtherProjects.astro';
import Closing from '../components/shell/Closing.astro';
import SectionRail from '../islands/SectionRail.tsx';
import FsSimCard from '../islands/FsSimCard';
import MarlCard from '../islands/MarlCard';
import HelmArchitecture from '../islands/HelmArchitecture';
---
<Shell title="Branson Tay · Portfolio" hideBar>
  <Hero />

  <div class="band-wrap">
    <ProjectFeature
      anchorId="work"
      panelId="PRJ/001"
      tier="FEATURED"
      title="Helm"
      kicker="Automatic CV generator app, built with an agentic harness on a self-improving loop."
      points={[
        'Live consumer product · 10 users · 20 CVs generated',
        'Generates a tailored CV from one job description',
        'Uses end-to-end evals and agentic harness to determine the quality of the CV output',
      ]}
      why="Teach myself system design, and self-improving harnesses in production environments"
      stack={['typescript', 'fastapi', 'k8s', 'sqs', 'cloudflare']}
      route="https://helmcv.app"
      routeLabel="Launch Helm"
      note="Source is private as Helm is a live product. The diagram shows the architecture instead."
    >
      <HelmArchitecture client:load />
    </ProjectFeature>
  </div>

  <div class="band-wrap">
    <ProjectFeature
      anchorId="marl"
      panelId="PRJ/002"
      tier="RESEARCH"
      title="MARL Racing Sim"
      kicker="When teamwork helps and when it hurts."
      points={[
        'Multi-Agent Reinforcement Learning in a custom-built F1-inspired action space',
        'Find learning strategies for teammates in a dynamic competitive environment',
        'Maps when team play speeds learning, and when it stalls it',
      ]}
      why="Investigate when cooperation and competition hurt AI agents working together."
      stack={['python', 'pytorch', 'dqn family']}
      route="/dissertation"
      routeLabel="View dissertation"
      repo="https://github.com/Brandnewson/F1_StrategySimulator"
      repoLabel="View code"
      reverse
    >
      <MarlCard client:load />
    </ProjectFeature>
  </div>

  <div class="band-wrap">
    <ProjectFeature
      anchorId="sim"
      panelId="PRJ/003"
      tier="SHIPPING"
      title="Quasi-Static Lap Time Simulator"
      kicker="Lap-time solver built from first principles, with a fitted tyre model"
      points={[
        'Actively used by Leeds Gryphon Racing to determine design trade-offs',
        'Predicts pace per track from mass, aero, tyres, and gearing',
        "Python FastAPI web app for engineers to easily use with RAG AI chatbot",
      ]}
      why="Let engineers reason about design choices in minutes, instead of hours of expensive track time"
      stack={['python', 'fastapi', 'api design', 'linear programming', 'web development', 'data modelling']}
      route="https://lgr-simulator.fly.dev/"
      routeLabel="Launch simulator"
      repo="https://github.com/LGRSimulations/LGR_FullTrackQSLapTimeSim"
      repoLabel="View code"
    >
      <FsSimCard client:load />
    </ProjectFeature>
  </div>

  <OtherProjects />

  <Profile />
  <Closing />

  <SectionRail client:idle />
</Shell>

<style lang="scss">
.band-wrap {
  // width:100% is required because .band-wrap is a flex item of main.page (a
  // column flexbox): the `margin: 0 auto` centring otherwise disables stretch
  // and shrink-wraps the band to its content width. Split bands only looked
  // full-width by coincidence of wide content; the stacked Helm band collapsed.
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 48px;

  @media (max-width: 900px) { padding: 0 26px; }
}
</style>
