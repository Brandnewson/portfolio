---
import Shell from '../layouts/Shell.astro';
import Hero from '../components/hero/Hero.astro';
import ProjectPanel from '../components/projects/ProjectPanel.astro';
---
<Shell title="Branson Tay — Portfolio" active="work">
  <Hero />

  <section class="projects" id="work">
    <div class="grid">
      <ProjectPanel
        panelId="PRJ/001"
        title="MARL Racing Sim"
        summary="Multi-agent reinforcement learning agents racing on procedurally generated tracks. Live λ-tuning of the reward function shifts strategy in real time."
        stack={['canvas 2d', 'pytorch', 'webworker']}
        route="/f1-sim"
        progress={87}
        offset="low"
      />
      <ProjectPanel
        panelId="PRJ/002"
        title="FS Quasi-Static Sim"
        summary="Lap-time simulator for a Formula Student car. LP solver runs offline; the browser interpolates pre-computed surfaces in <1ms."
        stack={['python lp', 'json lookup', 'react']}
        route="/formula-sim"
        progress={62}
        offset="high"
      />
      <ProjectPanel
        panelId="PRJ/003"
        title="Helm Showcase"
        summary="Forward-deployed CRM tooling for a YC-backed sales team. Custom dashboards, automation flows, and a GTM analytics pipeline."
        stack={['typescript', 'cloudflare', 'd3']}
        route="/helm"
        progress={45}
        offset="mid"
      />
    </div>

    <aside class="ambient" aria-label="Annotations">
      <span class="ambient-label mono">ANNOTATIONS</span>
      <p class="ambient-note">Reserved space — short asides, current reading, or what I'm tinkering with this week.</p>
    </aside>
  </section>
</Shell>

<style lang="scss">
.projects {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  padding: 6px 36px 18px;
  width: 100%;

  @media (min-width: 900px) {
    grid-template-columns: minmax(0, 1fr) 240px;
  }
}

.grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  align-items: stretch;
  min-height: 0;

  @media (min-width: 900px) {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
}

.ambient {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-left: 18px;
  border-left: 1px solid var(--bd);
  min-height: 0;
}

.ambient-label {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: var(--phos);
  text-shadow: var(--phos-glow);
}

.ambient-note {
  font-size: 11px;
  line-height: 1.5;
  color: var(--mut);
  font-style: italic;
}
</style>
