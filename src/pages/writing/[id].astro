---
// /writing/<id> — one rendered page per tech note. Static-generated from the
// tech-notes collection; the markdown body renders into the .prose block.
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import BackLink from '../../components/shell/BackLink.astro';

export async function getStaticPaths() {
  const notes = await getCollection('tech-notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<Shell title={`${note.data.title} — Branson Tay`}>
  <article class="note-page">
    <BackLink href="/writing" label="All notes" />

    <header class="note-page-head">
      <p class="eyebrow mono">{note.data.panel} · NOTE</p>
      <h1 class="note-page-title">{note.data.title}</h1>
      <p class="note-page-component mono">{note.data.component}</p>
      <p class="note-page-tags mono">{note.data.mechanism} · {note.data.substrate}</p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Shell>

<style lang="scss">
.note-page {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 28px 36px 72px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.note-page-head {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--bd);
}

.eyebrow {
  font-size: var(--fs-2xs);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--phos);
  text-shadow: var(--phos-glow);
  margin: 0;
}

.note-page-title {
  font-family: var(--font-hero);
  font-size: clamp(26px, 3.4vw, 40px);
  line-height: 1.08;
  letter-spacing: -0.014em;
  font-weight: 600;
  color: var(--fg);
  margin: 0;
}

.note-page-component {
  font-size: var(--fs-xs);
  letter-spacing: 0.06em;
  color: var(--fg2);
  margin: 4px 0 0;
}

.note-page-tags {
  font-size: var(--fs-3xs);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--mut);
  margin: 0;
}

// ── Rendered markdown ──
// Scoped prose styles — :global so they reach the markdown Astro injects into
// .prose (which this component's scoping wouldn't otherwise hash-match).
.prose {
  font-size: var(--fs-lg);
  line-height: 1.65;
  color: var(--fg2);

  :global(h2) {
    font-family: var(--font-hero);
    font-size: 20px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
    margin: 32px 0 10px;
  }

  :global(h3) {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--fg);
    margin: 22px 0 8px;
  }

  :global(p) {
    margin: 0 0 14px;
  }

  :global(ul),
  :global(ol) {
    margin: 0 0 16px;
    padding-left: 20px;
  }

  :global(li) {
    margin: 0 0 6px;
  }

  :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--bg2);
    border: 1px solid var(--bd);
    border-radius: 2px;
    padding: 1px 5px;
    color: var(--fg);
  }

  :global(pre) {
    background: var(--bg2);
    border: 1px solid var(--bd);
    border-radius: 2px;
    padding: 14px 16px;
    overflow-x: auto;
    margin: 0 0 16px;

    :global(code) {
      background: none;
      border: 0;
      padding: 0;
    }
  }
}

@media (max-width: 560px) {
  .note-page { padding: 22px 20px 56px; }
}
</style>
