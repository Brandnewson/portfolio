---
import '../styles/global.scss';

interface Props {
  title?: string;
  theme?: 'day' | 'night';
}

const { title = 'Branson — Portfolio', theme = 'day' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <!-- TODO: replace with self-hosted @font-face declarations once size-adjust width-match is dialled -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Chakra+Petch:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  />
</head>
<body>
  <slot />
</body>
</html>
