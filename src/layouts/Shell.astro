---
import '../styles/global.scss';
import InstrumentBar from '../components/shell/InstrumentBar.astro';

interface Props {
  title?: string;
  hideBar?: boolean;
}

const { title = 'Branson — Portfolio', hideBar = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!--
    Anti-flash: set data-theme synchronously from localStorage BEFORE styles
    parse. Without this, a night-mode user sees a brief day-mode flash on
    every page load.
  -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute(
          'data-theme',
          stored === 'night' ? 'night' : 'day'
        );
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'day');
      }
    })();
  </script>

  <!--
    Self-hosted fonts (see src/styles/_fonts.scss). Preload the heading face so
    it is resident at first paint. Instrument Sans is the heading font in both
    themes now, so there is only one face to preload.
  -->
  <link rel="preload" href="/fonts/instrument-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  {!hideBar && <InstrumentBar />}

  <main class="page">
    <slot />
  </main>
</body>
</html>

<style is:global>
  .page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }
  /* The landing redesign (2026-05-13) made the page taller than the viewport
     on purpose — three full-width project bands stacked vertically plus the
     experience/education/contact sections. The page scrolls at every width. */
</style>
