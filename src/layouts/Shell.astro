---
import '../styles/global.scss';
import InstrumentBar from '../components/shell/InstrumentBar.astro';

interface Props {
  title?: string;
  description?: string;
  hideBar?: boolean;
}

const {
  title = 'Branson Tay · Portfolio',
  description = 'Branson Tay, full-stack engineer building applied-AI tools that ship. Work across AI, simulation, and forward-deployed systems. Open to roles in London and New York.',
  hideBar = false,
} = Astro.props;

// Astro.site is set in astro.config.mjs, so these resolve to absolute URLs —
// required for canonical and for social cards (OG/Twitter need absolute image URLs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph: how the link renders when shared (LinkedIn, Slack, iMessage). -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Branson Tay" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X large-image card. -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!--
    Anti-flash: set data-theme synchronously from localStorage BEFORE styles
    parse. Without this, a night-mode user sees a brief day-mode flash on
    every page load.
  -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute(
          'data-theme',
          stored === 'night' ? 'night' : 'day'
        );
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'day');
      }
    })();
  </script>

  <!--
    Self-hosted fonts (see src/styles/_fonts.scss). Preload the heading face so
    it is resident at first paint. Instrument Sans is the heading font in both
    themes now, so there is only one face to preload.
  -->
  <link rel="preload" href="/fonts/instrument-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  {!hideBar && <InstrumentBar />}

  <main class="page">
    <slot />
  </main>
</body>
</html>

<style is:global>
  .page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }
  /* The landing redesign (2026-05-13) made the page taller than the viewport
     on purpose — three full-width project bands stacked vertically plus the
     experience/education/contact sections. The page scrolls at every width. */
</style>
