---
import '../styles/global.scss';
import InstrumentBar from '../components/shell/InstrumentBar.astro';

interface Props {
  title?: string;
}

const { title = 'Branson — Portfolio' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!--
    Anti-flash: set data-theme synchronously from localStorage BEFORE styles
    parse. Without this, a night-mode user sees a brief day-mode flash on
    every page load.
  -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        document.documentElement.setAttribute(
          'data-theme',
          stored === 'night' ? 'night' : 'day'
        );
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'day');
      }
    })();
  </script>

  <!-- TODO: replace with self-hosted @font-face once size-adjust width-match is dialled -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Chakra+Petch:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  />
</head>
<body>
  <InstrumentBar />

  <main class="page">
    <slot />
  </main>
</body>
</html>

<style is:global>
  .page {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }
  /* The landing redesign (2026-05-13) made the page taller than the viewport
     on purpose — three full-width project bands stacked vertically plus the
     experience/education/contact sections. The page scrolls at every width. */
</style>
