---
import ThemeToggle from '../../islands/ThemeToggle.tsx';
---
<section class="hero" id="top">
  <div class="wrap">
    <p class="name">Branson Tay</p>
    <div class="eyebrow-row">
      <p class="eyebrow mono">Full-stack engineer · AI × physical systems</p>
      <ThemeToggle client:load />
    </div>
    <h1 class="headline">I build applied-AI<br class="hbrk" />tools that <em>ship.</em></h1>
    <p class="sub">A full-stack engineer who ships production code end-to-end, with tools living on the internet and at the race track with real users. I drop into unfamiliar systems and love using entrepreneurial instincts to own problems from scoping to deployment.</p>

    <p class="status mono"><span class="live-dot" aria-hidden="true"></span> <b>OPEN TO WORK</b> · LONDON-BASED · US-AUTHORISED (H1B1) · FROM SEP 2026</p>

    <nav class="heronav" aria-label="Quick links">
      <a class="navcta navcta--primary" href="#work">
        <span class="nc-top"><span class="nc-label mono">Featured project</span><span class="nc-arrow" aria-hidden="true">↓</span></span>
        <span class="nc-sub">Automatic CV generator app</span>
      </a>
      <div class="quick-links">
        <a class="qlink mono" href="https://github.com/Brandnewson" target="_blank" rel="noopener noreferrer">GitHub <span class="ql-glyph" aria-hidden="true">↗</span></a>
        <a class="qlink mono" href="https://www.linkedin.com/in/bransontay" target="_blank" rel="noopener noreferrer">LinkedIn <span class="ql-glyph" aria-hidden="true">↗</span></a>
        <a class="qlink mono" href="#contact">Contact <span class="ql-glyph" aria-hidden="true">↓</span></a>
        <a class="qlink qlink--cv mono" href="/Branson-Tay-CV.pdf" download>Download CV <span class="ql-glyph" aria-hidden="true">↓</span></a>
      </div>
    </nav>
  </div>
</section>

<style lang="scss">
.hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding: 88px 0 56px; }

/* explicit line-height (not `normal`, which is font-metric dependent) keeps the
   name's box predictable across weights. */
.name { font-family: var(--font-hero); font-size: clamp(22px, 2.5vw, 32px); font-weight: 700; line-height: 1.1; letter-spacing: -0.01em; color: var(--fg); margin: 0 0 8px; }
.name::after { content: ''; display: block; width: 34px; height: 2px; background: var(--rule); margin-top: 12px; }

/* Eyebrow line with the day/night switch parked at its right edge — a quiet
   "calibrate" control tucked into the corner of the intro line rather than a
   labelled block of its own. Wraps the toggle under the eyebrow on narrow
   screens. */
.eyebrow-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 16px 0 22px; }
.eyebrow { font-size: var(--fs-xs); letter-spacing: 0.32em; text-transform: uppercase; color: var(--primary); margin: 0; }
/* The toggle's shared styles use --bar-* (tuned for the dark InstrumentBar).
   On the hero background, remap to page fg/mut so border + inactive glyph stay visible. */
.eyebrow-row :global(.theme-toggle) { --bar-fg: var(--fg); --bar-fg-mut: var(--mut); flex-shrink: 0; }

/* The explicit break (.hbrk) fixes the headline at two lines for a deliberate
   display shape. No max-width: the break governs wrapping, not a soft column. */
.headline { font-family: var(--font-hero); font-weight: 600; font-size: clamp(40px, 6vw, 80px); line-height: 0.98; letter-spacing: -0.025em; color: var(--fg); margin: 0; }
.headline em { font-style: normal; color: var(--emphasis); }

.sub { font-size: clamp(16px, 1.5vw, 20px); line-height: 1.5; color: var(--fg2); max-width: 54ch; margin-top: 24px; }

.status { display: inline-flex; align-items: center; gap: 10px; margin-top: 26px; font-size: var(--fs-xs); letter-spacing: 0.2em; text-transform: uppercase; color: var(--mut); }
.status b { color: var(--badge-fg); text-shadow: var(--badge-glow); font-weight: 600; }
.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--dot-bg); box-shadow: var(--dot-glow); flex-shrink: 0; animation: pulse 2.4s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

/* Hero CTAs: one primary featured-project card, then a lighter quick-links row
   (GitHub, LinkedIn, Contact, weighted CV) — secondary to the primary, per the
   IA spec. The toggle/calibrate control above stays out of the CTA budget. */
.heronav { margin-top: 44px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
.navcta { display: inline-flex; flex-direction: column; gap: 6px; min-width: 240px; padding: 16px 18px; border: 1px solid var(--bd); text-decoration: none; background: transparent; transition: border-color 0.15s ease, background 0.15s ease; }
.nc-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.nc-label { font-size: var(--fs-sm); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg); }
.nc-arrow { font-size: var(--fs-lg); color: var(--mut); transition: transform 0.15s ease, color 0.15s ease; }
.nc-sub { font-size: var(--fs-xs); color: var(--mut); }
.navcta:hover { border-color: var(--primary); }
.navcta:hover .nc-label { color: var(--primary); }
.navcta:hover .nc-arrow { transform: translateY(3px); color: var(--primary); }
.navcta--primary { border-color: var(--primary); border-left-width: 3px; background: var(--primary-tint); }
.navcta--primary .nc-label, .navcta--primary .nc-arrow { color: var(--primary); }
.navcta--primary:hover { border-color: var(--primary-hover); }

/* Secondary quick-links. Ghost buttons, with the CV given more weight (filled
   tint + primary border) since the recruiter's first want is the CV. Uses
   --primary (the brand/CTA colour), never phosphor. */
.quick-links { display: flex; flex-wrap: wrap; gap: 8px; }
.qlink { display: inline-flex; align-items: center; gap: 7px; padding: 9px 14px; border: 1px solid var(--bd); color: var(--fg); text-decoration: none; font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease; }
.qlink:hover { color: var(--primary); border-color: var(--primary); }
.ql-glyph { font-size: var(--fs-base); line-height: 1; color: var(--mut); transition: color 0.15s ease; }
.qlink:hover .ql-glyph { color: var(--primary); }
.qlink--cv { border-color: var(--primary); background: var(--primary-tint); color: var(--primary); }
.qlink--cv .ql-glyph { color: var(--primary); }
.qlink--cv:hover { border-color: var(--primary-hover); color: var(--primary-hover); }
.qlink--cv:hover .ql-glyph { color: var(--primary-hover); }

.mono { font-family: var(--font-mono); }

@media (max-width: 900px) {
  .navcta { min-width: 0; width: 100%; }
  .quick-links { width: 100%; }
  .qlink { flex: 1 1 auto; justify-content: center; }
}

/* On phones the fixed break can't fit "I build applied-AI" on one line, so let
   it wrap naturally — both fonts wrap alike at this size, so no jump. */
@media (max-width: 560px) {
  .hbrk { display: none; }
}
</style>
