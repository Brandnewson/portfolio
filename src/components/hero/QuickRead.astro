---
// QuickRead — three-bullet recruiter-glance aside that sits in the hero's
// right column. Each bullet is a single row: dot + KEY column (left) + body
// (right) with a thin vertical rule between subject and body.
//
// The STACK row uses a nested sub-grid so each technology bucket
// (Languages, AI / ML, Web / Infra) renders on its own line with an inline
// sub-header. Branson can expand each bucket without restructuring the row.
//
// KEY uses the sans body font (not mono) — mono at 10.5px is noticeably
// harder to read in uppercase tracked runs. Sub-headers in the STACK row
// also use sans for the same reason.
//
// Content is locked here rather than passed as props. The Quick Read is the
// hero's pitch line; if it needs to change it's a deliberate copy edit, not
// configuration.
---
<aside class="quick-read" aria-label="Quick read — three-line pitch">
  <div class="qr-label">QUICK READ</div>

  <div class="qr-row">
    <span class="qr-dot" aria-hidden="true"></span>
    <span class="qr-key">SHIPPED</span>
    <span class="qr-text qr-text--lines">
      <span class="qr-line">
        <span class="qr-org">Jaguar TCS Racing</span>
        <span class="qr-sep" aria-hidden="true">·</span>
        Formula E trackside strategy tools
      </span>
      <span class="qr-line">
        <span class="qr-org">Leeds Gryphon Racing</span>
        <span class="qr-sep" aria-hidden="true">·</span>
        quasi-static lap-time simulator
      </span>
      <span class="qr-line">
        <span class="qr-org">Helm</span>
        <span class="qr-sep" aria-hidden="true">·</span>
        self-improving CV generator agent
      </span>
    </span>
  </div>

  <div class="qr-row">
    <span class="qr-dot" aria-hidden="true"></span>
    <span class="qr-key">STACK</span>
    <span class="qr-text qr-text--stack">
      <span class="qr-substack">
        <span class="qr-subkey">Languages</span>
        <span class="qr-subvalue">Python, TypeScript, C++, MATLAB</span>
      </span>
      <span class="qr-substack">
        <span class="qr-subkey">AI / ML</span>
        <span class="qr-subvalue">PyTorch, RAG, Claude Code, Codex, agentic harnesses</span>
      </span>
      <span class="qr-substack">
        <span class="qr-subkey">Web / Infra</span>
        <span class="qr-subvalue">React, Astro, FastAPI, Node, AWS, K8s, Docker</span>
      </span>
    </span>
  </div>

  <div class="qr-row">
    <span class="qr-dot" aria-hidden="true"></span>
    <span class="qr-key">OPEN TO</span>
    <span class="qr-text qr-text--open">
      <span class="qr-grp">Full-stack<span class="qr-sep" aria-hidden="true">·</span>FDE<span class="qr-sep" aria-hidden="true">·</span>ML/AI</span>
      <span class="qr-bar" aria-hidden="true"></span>
      <span class="qr-grp qr-grp--meta">NYC + London</span>
      <span class="qr-bar" aria-hidden="true"></span>
      <span class="qr-grp qr-grp--meta">from Sep 2026</span>
    </span>
  </div>
</aside>

<style lang="scss">
.quick-read {
  width: 100%;
  padding: 20px 26px 22px;
  background: var(--bg2);
  border: 1px solid var(--bd);
  border-radius: 2px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.qr-label {
  font-size: 9px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 2px;
}

// ── Row layout ──
// Three columns: dot (auto), KEY (fixed 100px with right rule), body (fluid).
// Tightened column-gap to 14px so the dot reads as a marker for its KEY
// rather than a floating bullet on the far left.
.qr-row {
  display: grid;
  grid-template-columns: auto 100px 1fr;
  align-items: start;
  column-gap: 14px;
}

// Dot vertical alignment: with KEY using line-height 1.4 and font-size 10.5,
// the key's cap-line sits at ~5px from the top of its line box. Centering
// the dot (5px tall) on that cap means dot.top ≈ 3px from row top.
.qr-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 5px;
}

.qr-key {
  font-family: var(--font-sans);
  font-size: 10.5px;
  line-height: 1.4;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--fg);
  font-weight: 700;
  white-space: nowrap;
  padding: 0;
  border-right: 1px solid var(--bd);
  align-self: stretch;
}

.qr-text {
  font-size: 13px;
  line-height: 1.55;
  color: var(--fg2);
  text-wrap: pretty;
}

// ── STACK sub-rows ──
// Each bucket (Languages / AI / ML / Web / Infra) gets its own line with an
// inline sub-header. Sub-keys align in a column 110px wide so the bucket
// labels stack tidily.
.qr-text--stack {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.qr-substack {
  display: grid;
  grid-template-columns: 110px 1fr;
  column-gap: 14px;
  align-items: baseline;
}

// ── SHIPPED line list ──
// Each shipped item on its own line, no sub-keys. Same flex-column wrapper
// as STACK so vertical rhythm matches, but children are plain text lines.
.qr-text--lines {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.qr-line {
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg2);
}

// Org name leads each shipped line — slightly heavier + full-contrast so the
// eye lands on the team/product first, then the descriptor.
.qr-org {
  color: var(--fg);
  font-weight: 600;
}

// Middot separator between org and descriptor (and in the OPEN TO row). Muted
// so it divides without competing.
.qr-sep {
  color: var(--mut);
  opacity: 0.6;
  margin: 0 2px;
}

// OPEN TO row: three semantic groups (roles / location / timing) on one line.
// A taller vertical bar divides the groups; the lighter middots separate items
// *within* the roles group. This two-level hierarchy is what makes the line
// scannable instead of one flat middot run.
.qr-text--open {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

// Each group stays intact on wrap (never breaks mid-group).
.qr-grp {
  white-space: nowrap;
}

// Location + timing are secondary to the roles — muted so roles lead the eye.
.qr-grp--meta {
  color: var(--mut);
}

// Between-group divider — a short vertical rule, stronger than the within-group
// middots so the three facets read as distinct chunks at a glance.
.qr-bar {
  display: inline-block;
  width: 1px;
  height: 11px;
  margin: 0 11px;
  background: var(--mut);
  opacity: 0.55;
}

.qr-subkey {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 600;
  color: var(--mut);
  white-space: nowrap;
}

.qr-subvalue {
  font-size: 13px;
  line-height: 1.55;
  color: var(--fg2);
}

@media (max-width: 900px) {
  .qr-row {
    grid-template-columns: auto 1fr;
    row-gap: 4px;
  }
  // On narrow viewports KEY drops above body; rule disappears.
  .qr-key {
    grid-column: 2;
    border-right: 0;
  }
  .qr-text {
    grid-column: 2;
  }
  .qr-substack {
    grid-template-columns: auto 1fr;
    column-gap: 10px;
  }
}
</style>
