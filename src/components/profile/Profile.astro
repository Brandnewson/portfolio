---
import { BIO, EXPERIENCE, EDUCATION, STACK } from '../../data/profile';
---
<section class="profile" id="profile">
  <div class="wrap">
    <span class="sec-rule" aria-hidden="true"></span>
    <div class="profile-head">
      <div class="phead mono"><span class="pid">PROFILE</span><span aria-hidden="true">·</span><span class="tier">WHO I AM</span></div>
      <h2 class="ptitle">Background</h2>
      <p class="bio">{BIO}</p>
    </div>

    <div class="pgrid">
      <div class="pcol">
        <div class="col-key mono">Experience</div>
        <ol class="timeline" role="list">
          {EXPERIENCE.map((e) => (
            <li>
              <div class="tl-when mono">{e.when}</div>
              <div class="tl-main">
                <span class="tl-org">{e.org}</span>
                <span class="tl-role">{e.role}</span>
                <span class="tl-loc mono">{e.location}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="pcol">
        <div class="col-key mono">Education</div>
        <div class="edu">
          {EDUCATION.map((e) => (
            <div class="edu-item">
              <div class="edu-top"><span class="edu-org">{e.org}</span><span class="edu-when mono">{e.when}</span></div>
              <div class="edu-qual">{e.qual}</div>
              <ul class="edu-points" role="list">
                {e.points.map((pt) => <li class="edu-point">{pt}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="stack-block">
      <div class="col-key mono">Stack</div>
      <div class="stk">
        {STACK.map((s) => (
          <div class="stk-row"><span class="stk-key">{s.key}</span><span class="stk-val">{s.value}</span></div>
        ))}
      </div>
    </div>

  </div>
</section>

<style lang="scss">
.profile { padding: 72px 0 108px; }
/* Divider that separates the Helm band above from the Background section —
   matches the 2px accent rule that tops each project band. */
.sec-rule { display: block; height: 2px; width: 100%; background: var(--rule); margin-bottom: 52px; }
.profile-head { margin-bottom: 44px; max-width: 60ch; }

.phead { display: flex; align-items: center; gap: 10px; font-size: var(--fs-2xs); letter-spacing: 0.22em; text-transform: uppercase; color: var(--mut); margin-bottom: 14px; }
.pid { color: var(--phos); text-shadow: var(--phos-glow); font-weight: 600; }
.tier { color: var(--fg); font-weight: 600; }

.ptitle { font-family: var(--font-hero); font-weight: 600; font-size: clamp(28px, 3vw, 42px); line-height: 1.05; letter-spacing: -0.015em; color: var(--fg); margin: 10px 0 0; }
.bio { margin-top: 18px; font-size: 16px; line-height: 1.6; color: var(--fg2); }

.pgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
.col-key { font-size: var(--fs-xs); letter-spacing: 0.24em; text-transform: uppercase; color: var(--primary); margin-bottom: 8px; }

.timeline { list-style: none; margin: 0; padding: 0; }
.timeline li { display: grid; grid-template-columns: 78px 1fr; gap: 18px; padding: 16px 0; border-top: 1px solid var(--bd); }
.tl-when { font-size: var(--fs-xs); color: var(--mut); letter-spacing: 0.04em; padding-top: 3px; }
.tl-main { display: flex; flex-direction: column; gap: 2px; }
.tl-org { font-size: var(--fs-xl); font-weight: 600; color: var(--fg); }
.tl-role { font-size: var(--fs-md); color: var(--fg2); }
.tl-loc { font-size: var(--fs-xs); color: var(--mut); letter-spacing: 0.04em; margin-top: 2px; }

.edu { margin: 0; }
.edu-item { padding: 18px 0; border-top: 1px solid var(--bd); }
.edu-top { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
.edu-org { font-size: var(--fs-xl); font-weight: 600; color: var(--fg); }
.edu-when { font-size: var(--fs-xs); color: var(--mut); letter-spacing: 0.04em; white-space: nowrap; }
.edu-qual { font-size: var(--fs-md); color: var(--fg2); margin-top: 2px; }
/* Achievement lines — separated rows with the same squared primary pip used by
   the project bands, so they scan as distinct points rather than a paragraph. */
.edu-points { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
.edu-point { position: relative; padding-left: 14px; font-size: var(--fs-md); line-height: 1.5; color: var(--fg2); }
.edu-point::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 4px; height: 4px; background: var(--primary); }

.stack-block { margin-top: 56px; }
.stk { margin-top: 6px; display: grid; grid-template-columns: 1fr 1fr; column-gap: 56px; }
.stk-row { display: grid; grid-template-columns: 118px 1fr; gap: 16px; padding: 14px 0; border-top: 1px solid var(--bd); align-items: baseline; }
.stk-key { font-size: var(--fs-sm); font-weight: 600; color: var(--mut); }
.stk-val { font-size: var(--fs-lg); color: var(--fg); line-height: 1.5; }

@media (max-width: 900px) {
  .pgrid { grid-template-columns: 1fr; gap: 44px; }
  .stk { grid-template-columns: 1fr; column-gap: 0; }
}

.mono { font-family: var(--font-mono); }
</style>
