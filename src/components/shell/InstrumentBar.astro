---
import ThemeToggle from '../../islands/ThemeToggle.tsx';
---
<header class="instrument-bar">
  <a class="logo" href="/" aria-label="Branson — home">
    Branson<span class="live-dot" aria-hidden="true"></span>
  </a>

  <div class="bar-right">
    <span class="inspiration-wrap" aria-live="polite">
      <span class="inspiration day-line">Inspired by a 911 Targa sitting in Maranello</span>
      <span class="inspiration night-line">Inspired by a 300ZX cruising on the motorway</span>
    </span>
    <ThemeToggle client:load />
  </div>
</header>

<style lang="scss">
// Two columns: 1fr | auto. The nav was removed (the page's own CTAs carry the
// navigation intent), so the bar is now just identity on the left and the
// inspiration line + theme toggle pushed to the right.
.instrument-bar {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 6px 36px;
  background: var(--bar-bg);
  color: var(--bar-fg);
  border-bottom: 1px solid var(--bd);
  font-family: var(--font-sans);
  flex-shrink: 0;
}

.logo {
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.04em;
  color: var(--bar-fg);
}

.live-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-left: 5px;
  border-radius: 50%;
  background: var(--dot-bg);
  box-shadow: var(--dot-glow);
  vertical-align: middle;
  animation: pulse 2.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.55; }
}

.bar-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14px;
}

// Grid-stack both inspiration lines in the same cell so width = max of both
// — toggling theme swaps visibility (not display), so layout never shifts.
.inspiration-wrap {
  display: inline-grid;
  grid-template-columns: 1fr;
}
.inspiration {
  grid-area: 1 / 1;
  visibility: hidden;
  font-family: var(--font-sans);
  font-size: 10px;
  font-style: italic;
  letter-spacing: 0.01em;
  color: var(--bar-fg-mut);
  white-space: nowrap;
}

:global(html[data-theme="day"]) .day-line { visibility: visible; }
:global(html[data-theme="night"]) .night-line { visibility: visible; }

</style>
