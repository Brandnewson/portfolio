---
// BackLink — the single navigation affordance on sub-pages.
//
// The header bar is intentionally nav-less (navigation into other pages is
// carried by the home page's own CTAs), so each sub-page gets one clear way
// back. Neutral palette — this is navigation chrome, never a live element, so
// no phosphor.
interface Props {
  href?: string;
  label?: string;
}
const { href = '/', label = 'Back' } = Astro.props;
---
<a class="back-link mono" href={href}>
  <span class="back-glyph" aria-hidden="true">←</span>
  <span class="back-label">{label}</span>
</a>

<style lang="scss">
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: var(--fs-2xs);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--mut);
  transition: color 0.15s ease;

  &:hover {
    color: var(--primary);
  }
}

.back-glyph {
  font-size: var(--fs-base);
  line-height: 1;
  transition: transform 0.15s ease;
}

.back-link:hover .back-glyph {
  transform: translateX(-3px);
}
</style>
