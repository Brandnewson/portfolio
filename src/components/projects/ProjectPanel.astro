---
// Project panel — the visual focus of the landing page.
// Three of these fill the horizontal space below the hero. Each has a
// .preview region that's reserved for the eventual interactive island
// (MARL canvas, FS sim sliders, Helm screenshot, etc).
// Theme-aware via semantic tokens — no [data-theme] selectors.

interface Props {
  panelId: string;
  title: string;
  summary: string;
  stack: string[];
  route?: string;
  download?: string;
  // Suggested save-as filename for the downloaded file. The visible label still
  // comes from the URL basename — `downloadAs` only affects what the browser
  // names the saved file (e.g. "BRANSON TAY REPORT.pdf" while the button reads
  // "REPORT.PDF").
  downloadAs?: string;
  kicker?: string;
}

const {
  panelId,
  title,
  summary,
  stack,
  route,
  download,
  downloadAs,
  kicker,
} = Astro.props;

const downloadLabel = download ? download.split('/').pop()?.toUpperCase() : null;

// When a child is passed, the .preview slot replaces the placeholder content.
const hasPreview = Astro.slots.has('default');
---
<article class="panel">
  <span class="acc-rule" aria-hidden="true"></span>

  <header class="head mono">
    <span class="pid">{panelId}</span>
  </header>

  <div class="title-row">
    <h3 class="title">{title}</h3>
    {download ? (
      <a class="download mono" href={download} download={downloadAs ?? true}>
        <span class="download-icon" aria-hidden="true">↓</span>
        <span>{downloadLabel}</span>
      </a>
    ) : route && <a class="route mono" href={route}>{route} →</a>}
  </div>
  {kicker && <p class="kicker">{kicker}</p>}
  <p class="summary">{summary}</p>

  {hasPreview ? (
    <div class="preview is-hydrated">
      <slot />
    </div>
  ) : (
    <div class="preview" aria-hidden="true">
      <span class="preview-marker mono">PRJ_PREVIEW</span>
      <span class="preview-hint mono">awaiting hydration</span>
      <div class="preview-grid"></div>
    </div>
  )}

  <ul class="stack" role="list">
    {stack.map((tech) => <li class="chip mono">{tech}</li>)}
  </ul>
</article>

<style lang="scss">
.panel {
  position: relative;
  background: var(--bg2);
  border: 1px solid var(--bd);
  border-radius: 2px;
  padding: 18px 20px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: transform 0.18s ease, border-color 0.18s ease;

  &:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
  }
}

.acc-rule {
  position: absolute;
  top: -1px; left: -1px; right: -1px;
  height: 2px;
  background: var(--rule);
}

.head {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mut);
}

.pid {
  color: var(--phos);
  text-shadow: var(--phos-glow);
  font-weight: 500;
}

.title-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  justify-content: space-between;
}

.kicker {
  font-size: 11px;
  font-style: italic;
  color: var(--emphasis);
  line-height: 1.35;
  margin: -4px 0 0;
}

.title {
  font-family: var(--font-hero);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.005em;
  color: var(--fg);
  line-height: 1.08;
}

.route {
  flex-shrink: 0;
  font-size: 10px;
  color: var(--primary);
  text-decoration: none;
  letter-spacing: 0.14em;
  &:hover { color: var(--primary-hover); }
}

// Download affordance — same pattern as the hero resume link (mono uppercase
// label + phosphor ↓ glyph) but inlined into the title row instead of a
// chunky vertical card, so it sits alongside the panel title.
.download {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  padding: 4px 8px;
  border: 1px solid var(--bd);
  font-size: 9px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--fg);
  text-decoration: none;
  transition: border-color 0.15s ease, color 0.15s ease;

  &:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
}

.download-icon {
  color: var(--phos);
  text-shadow: var(--phos-glow);
  font-size: 12px;
  line-height: 1;
}

.summary {
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg2);
}

// ── Preview region — placeholder for the eventual interactive island ──
.preview {
  position: relative;
  flex: 1;
  min-height: 140px;
  background: var(--bg);
  border: 1px dashed var(--bd);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 10px 12px;
  overflow: hidden;
  margin-top: 4px;

  // When a live island fills the slot, the dashed frame + placeholder
  // affordances disappear so the content reads as the panel's own.
  // overflow is `visible` here so the island can drive panel height — with
  // overflow:hidden the island would get clipped at the preview's flex-sized
  // box instead of growing the panel to fit.
  &.is-hydrated {
    border: 0;
    padding: 0;
    background: transparent;
    justify-content: stretch;
    overflow: visible;
    flex: none;
  }
}

.preview-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, var(--bd) 1px, transparent 1px),
    linear-gradient(to bottom, var(--bd) 1px, transparent 1px);
  background-size: 32px 32px;
  opacity: 0.5;
  pointer-events: none;
}

.preview-marker {
  position: relative;
  z-index: 1;
  font-size: 9px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--phos);
  text-shadow: var(--phos-glow);
}
.preview-hint {
  position: relative;
  z-index: 1;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mut);
  opacity: 0.7;
}

.stack {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.chip {
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  padding: 3px 7px;
  border: 1px solid var(--bd);
  color: var(--mut);
}
</style>
